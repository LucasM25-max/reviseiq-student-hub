# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- ReviseIQ ---------------------------------------------------------------
# The example file documents required keys and must be committed; real .env files
# are matched by the `.env*` rule above.
!.env.example

# Prisma Client is generated from prisma/schema.prisma by `npm run db:generate`
# (also wired to postinstall), so it never belongs in version control.
/src/generated/

# Local mail transport: emails written to disk when RESEND_API_KEY is unset.
/.mail/

# Placeholder created when Prisma's engine CDN is unreachable (scripts/prisma-generate.mjs)
/.prisma-stub/

# Embedded PostgreSQL data directory, if DEV_DB_DIR is pointed inside the repo
/.devdb/
