# ---------------------------------------------------------------------------
# ReviseIQ environment variables
#
# Copy to .env for local development:  cp .env.example .env
# Every variable is validated at boot by src/lib/env.ts — the app fails fast
# with a readable message rather than blowing up later with `undefined`.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local development uses the embedded PostgreSQL server: npm run db:start
DATABASE_URL="postgresql://reviseiq:reviseiq@127.0.0.1:55432/reviseiq"
# Production (Neon): set DIRECT_URL to the non-pooled connection for migrations.
# DIRECT_URL=""

# --- Auth (required) -------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Canonical origin. Must match the deployment URL in production.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google OAuth (optional) -----------------------------------------------
# When absent, the Google buttons render disabled and email/password still works.
# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (optional) ------------------------------------------------------
# When absent, emails are written to the server console and to ./.mail so the
# verification and password-reset flows are fully testable without a provider.
RESEND_API_KEY=""
EMAIL_FROM="ReviseIQ <noreply@reviseiq.app>"

# --- AI (Phase 5, not used yet) --------------------------------------------
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
