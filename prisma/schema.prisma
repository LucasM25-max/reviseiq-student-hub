// ReviseIQ — database schema
// Phases 0–2: identity, student profile, curriculum taxonomy, enrolment, RAG, availability.
// Later phases (content, attempts, flashcards, plans) are specified in docs/plan/03-data-model.md.
//
// Prisma 7: the connection URL lives in prisma.config.ts, not here, and the client is
// Rust-free — it connects through the @prisma/adapter-pg driver adapter (see src/lib/db/prisma.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity — Auth.js v5 core models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  /// argon2id. Null for accounts created via Google only.
  passwordHash  String?
  /// Collected solely for the age gate (under-13s are blocked) and age-appropriate defaults.
  dateOfBirth   DateTime? @db.Date
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts               Account[]
  sessions               Session[]
  authenticators         Authenticator[]
  profile                StudentProfile?
  enrolments             SubjectEnrolment[]
  ragRatings             RagRating[]
  availability           AvailabilitySlot[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  lessonProgress         LessonProgress[]
  lessonCheckAttempts    LessonCheckAttempt[]
  aiUsage                AiUsage[]
  specPointMastery       SpecPointMastery[]
  flashcards             Flashcard[]
  blurtAttempts          BlurtAttempt[]
  questionSets           QuestionSet[]
  questionAttempts       QuestionAttempt[]

  @@index([deletedAt])
}

enum Role {
  STUDENT
  ADMIN
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// Unused at runtime — the Credentials provider forces JWT sessions — but the
/// Prisma adapter requires the model to exist.
model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// WebAuthn. Not used in v1; present because the adapter's types expect it.
model Authenticator {
  credentialID         String  @id
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Identity — our own tokens (hashed at rest, never stored in plaintext)
// ---------------------------------------------------------------------------

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  /// sha256 of the token that was emailed. The raw token exists only in the email.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Postgres-backed token bucket. Avoids adding Redis as a dependency in v1
/// (docs/plan/02-architecture.md).
model RateBucket {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}

// ---------------------------------------------------------------------------
// Student profile
// ---------------------------------------------------------------------------

model StudentProfile {
  userId String @id

  displayName String?
  timezone    String    @default("Europe/London")
  /// D26 — Year 10 and Year 11 get materially different scheduling behaviour.
  yearGroup   YearGroup @default(YEAR_11)

  dailyGoalMinutes   Int @default(30)
  /// D24 — holidays are a different regime from term time.
  holidayGoalMinutes Int @default(60)

  onboardingStep        OnboardingStep @default(SUBJECTS)
  onboardingCompletedAt DateTime?

  // Habit layer (D35): streaks only. No XP, no levels, no achievements.
  streakCurrent     Int       @default(0)
  streakLongest     Int       @default(0)
  streakFreezesLeft Int       @default(2)
  lastActiveDate    DateTime? @db.Date

  // End of the exam season (D27)
  examsCompletedAt      DateTime?
  congratulationsSeenAt DateTime?
  schedulingEnabled     Boolean   @default(true)

  // Preferences
  reminderChannel ReminderChannel @default(NONE)
  /// e.g. ["18:30"] — local times in the profile timezone.
  reminderTimes   String[]        @default([])
  reduceMotion    Boolean         @default(false)
  dyslexiaFont    Boolean         @default(false)
  theme           String          @default("system")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum YearGroup {
  YEAR_10
  YEAR_11
  OTHER
}

enum ReminderChannel {
  NONE
  EMAIL
  PUSH
  BOTH
}

/// Tracks progress through onboarding so it is resumable.
enum OnboardingStep {
  SUBJECTS
  SETUP
  RAG
  AVAILABILITY
  DONE
}

// ---------------------------------------------------------------------------
// Curriculum taxonomy (seeded; read-mostly)
// ---------------------------------------------------------------------------

model Subject {
  id          String      @id
  code        SubjectCode @unique
  examBoard   String      @default("AQA")
  qualCode    String
  name        String
  /// Tailwind token suffix used for the subject accent colour.
  accent      String
  order       Int
  topics      Topic[]
  enrolments  SubjectEnrolment[]
  practicals  Practical[]
  questions   Question[]
}

enum SubjectCode {
  BIOLOGY
  CHEMISTRY
  PHYSICS
}

model Topic {
  id        String @id
  subjectId String
  /// AQA specification code, e.g. "4.1".
  code      String
  number    Int
  title     String
  /// Which exam paper this topic is assessed on.
  paper     Int
  order     Int

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subTopics  SubTopic[]
  ragRatings RagRating[]

  @@unique([subjectId, code])
  @@index([subjectId, order])
}

/// Progressive sub-topic RAG (D19) depends on it. Content hangs off it from Phase 3.
model SubTopic {
  id      String @id
  topicId String
  /// AQA specification code, e.g. "4.1.1".
  code    String
  title   String
  order   Int

  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  ragRatings   RagRating[]
  specPoints   SpecPoint[]
  lessons      Lesson[]
  noteSections NoteSection[]
  blurtPrompts BlurtPrompt[]
  questions    Question[]

  @@unique([topicId, code])
  @@index([topicId, order])
}

// ---------------------------------------------------------------------------
// Student state
// ---------------------------------------------------------------------------

model SubjectEnrolment {
  id        String     @id @default(cuid())
  userId    String
  subjectId String
  tier      TierChoice @default(UNSURE)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examDates ExamDate[]

  @@unique([userId, subjectId])
  @@index([userId])
}

enum TierChoice {
  FOUNDATION
  HIGHER
  UNSURE
}

model ExamDate {
  id          String   @id @default(cuid())
  enrolmentId String
  paper       Int
  date        DateTime @db.Date
  /// false when the date is an estimate ("summer of 2027") rather than a real timetable entry.
  confirmed   Boolean  @default(false)

  enrolment SubjectEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([enrolmentId, paper])
}

/// D19 — topic-level at onboarding, sub-topic added progressively later.
/// effectiveRag(subTopic) = subTopicRating ?? parentTopicRating
model RagRating {
  id         String    @id @default(cuid())
  userId     String
  scope      RagScope
  topicId    String?
  subTopicId String?
  value      RagValue
  source     RagSource @default(USER)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic?    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subTopic SubTopic? @relation(fields: [subTopicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@unique([userId, subTopicId])
  @@index([userId, value])
}

enum RagScope {
  TOPIC
  SUBTOPIC
}

enum RagValue {
  NOT_LEARNT
  RED
  AMBER
  GREEN
}

enum RagSource {
  USER
  SUGGESTED_ACCEPTED
  IMPORTED
}

model AvailabilitySlot {
  id      String  @id @default(cuid())
  userId  String
  /// 0 = Sunday … 6 = Saturday (matches JavaScript's Date#getDay).
  weekday Int
  minutes Int
  /// Optional preferred start time, "HH:mm" in the profile timezone.
  preferredStart String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekday])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Content (Phase 3) — seeded from /content, never edited by hand or by the app.
// docs/plan/03-data-model.md §2, docs/plan/04-content-pipeline.md
// ---------------------------------------------------------------------------

enum Tier {
  BOTH
  FOUNDATION
  HIGHER
}

enum Coverage {
  FULL
  PARTIAL
}

enum QuestionType {
  MCQ
  SHORT
  CALCULATION
  EXTENDED
  PRACTICAL
  DATA_RESPONSE
}

enum AO {
  AO1
  AO2
  AO3
}

model SpecPoint {
  id           String   @id
  subTopicId   String
  /// AQA specification code. Not unique: one code can yield several assessable points.
  code         String
  statement    String
  tier         Tier     @default(BOTH)
  mathsSkills  String[]
  wsSkills     String[]
  practicalIds String[]
  /// PARTIAL when something in the statement is knowingly deferred (D50 reporting).
  coverage     Coverage @default(FULL)
  /// Slice ids that must land before `coverage` can become FULL.
  blockedBy    String[]
  order        Int

  subTopic        SubTopic               @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  questionLinks   QuestionSpecPoint[]
  lessonBlockRefs LessonBlockSpecPoint[]
  mastery         SpecPointMastery[]
  cardTemplates   CardTemplate[]
  flashcards      Flashcard[]

  @@index([subTopicId, order])
}

model Lesson {
  id         String @id
  subTopicId String
  slug       String
  title      String
  summary    String
  order      Int
  estMinutes Int
  tier       Tier   @default(BOTH)
  /// Typed block array, zod-validated before it is written here.
  blocks     Json
  version    Int    @default(1)

  subTopic      SubTopic               @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  blockRefs     LessonBlockSpecPoint[]
  progress      LessonProgress[]
  checkAttempts LessonCheckAttempt[]
  questionSets  QuestionSet[]

  @@unique([subTopicId, slug])
  @@index([subTopicId, order])
}

/// Flattened join so coverage can be queried in SQL rather than by walking `Lesson.blocks`.
model LessonBlockSpecPoint {
  id          String @id
  lessonId    String
  specPointId String
  blockIndex  Int
  /// Recap blocks never satisfy coverage on their own (D39).
  recap       Boolean @default(false)

  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  specPoint SpecPoint @relation(fields: [specPointId], references: [id], onDelete: Cascade)

  @@unique([lessonId, blockIndex, specPointId])
  @@index([specPointId])
}

model NoteSection {
  id             String   @id
  subTopicId     String
  /// Becomes the #anchor Today deep-links to. Permanent once shipped.
  slug           String
  title          String
  body           String
  tier           Tier     @default(BOTH)
  specPointCodes String[]
  order          Int

  subTopic SubTopic @relation(fields: [subTopicId], references: [id], onDelete: Cascade)

  @@unique([subTopicId, slug])
  @@index([subTopicId, order])
}

model Practical {
  id          String   @id
  subjectId   String
  number      Int
  title       String
  requirement String
  aim         String
  apparatus   String[]
  /// [{ n, text, why? }] — the method, in the exam's language.
  method      Json
  safety      String[]
  /// The fault table (D50): authored as data in Phase 3, rendered by the engine in Phase 4b.
  faults      Json
  subTopicIds String[]
  atSkills    String[]
  coverage    Coverage @default(FULL)
  blockedBy   String[]

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, number])
}

model BlurtPrompt {
  id             String @id
  subTopicId     String
  prompt         String
  /// [{ id, idea, aliases[], essential }]
  expectedPoints Json
  tier           Tier   @default(BOTH)
  estMinutes     Int    @default(4)
  order          Int

  subTopic SubTopic @relation(fields: [subTopicId], references: [id], onDelete: Cascade)
  attempts BlurtAttempt[]

  @@index([subTopicId, order])
}

model Question {
  id                String       @id
  subjectId         String
  primarySubTopicId String
  type              QuestionType
  tier              Tier         @default(BOTH)
  paper             Int
  marks             Int
  commandWord       String
  ao                AO
  difficulty        Int
  stem              String
  /// { diagramId?, dataTable?, figureCaption? }
  assets            Json?
  /// MCQ options: [{ key, text }]
  options           Json?
  /// MCQ/objective answer key — marked deterministically, never by the model.
  correctKey        String?
  estSeconds        Int
  version           Int          @default(1)
  retired           Boolean      @default(false)

  subject    Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subTopic   SubTopic            @relation(fields: [primarySubTopicId], references: [id], onDelete: Cascade)
  markScheme MarkScheme?
  specPoints QuestionSpecPoint[]
  attempts   QuestionAttempt[]
  cardTemplates CardTemplate[]

  @@index([subjectId, tier, paper])
  @@index([primarySubTopicId, tier])
}

model QuestionSpecPoint {
  questionId  String
  specPointId String
  weight      Float  @default(1)

  question  Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  specPoint SpecPoint @relation(fields: [specPointId], references: [id], onDelete: Cascade)

  @@id([questionId, specPointId])
  @@index([specPointId])
}

model MarkScheme {
  questionId String @id
  /// [{ id, text, marks, alternatives[], reject[] }] — atomic, independently awardable.
  points     Json
  guidance   String?
  ecfRules   String?
  /// Shown to the student after marking. NEVER sent to the marker (doc 04).
  modelAnswer String?
  /// D49: { accept:{min,max}, unit, significantFigures?, methodPoints[], ecf }.
  /// Present ⇒ marked deterministically in-app, never by the model.
  numericAnswer Json?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Activity (Phase 4 — Learn)
// ---------------------------------------------------------------------------
// Everything below records what a student *did*. It is deliberately separate from the
// content tables above, which are seeded from /content and never written by the app.

/// Where a student has got to in a lesson, and how long it took them.
///
/// `lastBlockIndex` is the index of the last block that has been revealed, not the last
/// step — steps are derived from the block array (src/lib/learn/stages.ts), so changing
/// how a lesson is chunked never invalidates saved progress.
model LessonProgress {
  id             String        @id @default(cuid())
  userId         String
  lessonId       String
  lastBlockIndex Int           @default(0)
  state          ProgressState @default(IN_PROGRESS)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  /// Wall-clock seconds, accumulated per advance and capped per step so an abandoned
  /// tab cannot inflate it (src/lib/learn/time.ts).
  totalSeconds   Int           @default(0)
  /// When the student was last seen moving through this lesson. The clock runs from here.
  lastActivityAt DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, state])
}

enum ProgressState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// An answer to an inline `check` block.
///
/// Checks are not assessment — they never create a flashcard (D11) — but they are
/// persisted, because a step gated on a check cannot be resumed unless we know the
/// student already answered it. One row per block, updated on a retry, with the first
/// attempt kept separately since that is the one that means anything.
model LessonCheckAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  blockIndex  Int
  chosenKey   String
  correct     Boolean
  firstCorrect Boolean
  attempts    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, blockIndex])
  @@index([userId, lessonId])
}

/// A snapshotted set of questions, so a deep link stays stable and resumable.
///
/// Phase 4 uses it for end-of-lesson mastery checks; Phase 5 and Phase 7 reuse it for
/// practice sets and Today deep links, which is why `lessonId` is optional.
model QuestionSet {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String?
  questionIds String[]
  reason      String
  createdAt   DateTime  @default(now())
  /// Set when every question has been answered. Self-marking may still be outstanding.
  answeredAt  DateTime?
  /// Set when marking is finished and the score is final.
  completedAt DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempts QuestionAttempt[]

  @@index([userId, createdAt])
  @@index([userId, lessonId])
}

model QuestionAttempt {
  id           String         @id @default(cuid())
  userId       String
  questionId   String
  context      AttemptContext
  setId        String?
  answerText   String?
  answerKey    String?
  awardedMarks Int            @default(0)
  maxMarks     Int
  markedBy     MarkedBy
  /// Per-mark-point detail. Phase 4 writes the deterministic checks it can make;
  /// Phase 5 adds the AI marker's breakdown in the same shape.
  markDetail   Json?
  aiConfidence Float?
  /// Which prompt produced an AI mark, so a prompt change can be evaluated later.
  promptVersion String?
  disputed     Boolean        @default(false)
  disputeReason String?
  disputedAt   DateTime?
  durationSec  Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  set      QuestionSet? @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, questionId])
  @@index([userId, questionId])
  @@index([userId, createdAt])
}

enum AttemptContext {
  LESSON_CHECK
  PRACTICE
  MINI_MOCK
  FULL_MOCK
  MASTERY_CHECK
}

enum MarkedBy {
  AUTO
  AI
  AI_FALLBACK
  SELF
}

// ---------------------------------------------------------------------------
// Phase 5 — AI marking
// ---------------------------------------------------------------------------

/// Exact-answer cache for AI marks (doc 06 §6).
///
/// GCSE short answers repeat heavily across students, so the same (question, answer)
/// pair is marked once and replayed. Keyed on the model and prompt version as well as
/// the answer, because a mark produced by a different prompt is a different mark.
model MarkCache {
  /// sha256(questionId + model + promptVersion + normalisedAnswer).
  key           String   @id
  questionId    String
  model         String
  promptVersion String
  /// The post-processed MarkResult, exactly as it was served.
  result        Json
  hits          Int      @default(0)
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@index([questionId])
  @@index([lastUsedAt])
}

/// Cost and reliability ledger. One row per call, including cache hits and fallbacks,
/// so per-student cost and the global ceiling are both answerable from one table.
model AiUsage {
  id            String     @id @default(cuid())
  userId        String?
  feature       AiFeature
  model         String
  promptVersion String
  inputTokens   Int        @default(0)
  outputTokens  Int        @default(0)
  /// Micro-dollars (1e-6 USD) — integers, because floating point money is a bug.
  costMicroUsd  Int        @default(0)
  latencyMs     Int        @default(0)
  outcome       AiOutcome
  createdAt     DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([feature, createdAt])
}

enum AiFeature {
  MARK
  MARK_BATCH
  BLURT
  TUTOR
  CARD_TEXT
}

enum AiOutcome {
  OK
  CACHED
  FALLBACK_NO_KEY
  FALLBACK_QUOTA
  FALLBACK_CEILING
  FALLBACK_ERROR
  FALLBACK_SCHEMA
  ERROR
}

/// Rolling per-spec-point mastery, updated from every marked attempt.
///
/// Held as an exponential moving average of proportion-of-marks rather than a raw
/// total, so recent work counts for more and a bad week early on does not haunt a
/// student forever. Today reads this to decide what to schedule.
model SpecPointMastery {
  id          String   @id @default(cuid())
  userId      String
  specPointId String
  /// 0–1 exponential moving average of marks earned / marks available.
  mastery     Float    @default(0)
  attempts    Int      @default(0)
  marksEarned Int      @default(0)
  marksTotal  Int      @default(0)
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  specPoint SpecPoint @relation(fields: [specPointId], references: [id], onDelete: Cascade)

  @@unique([userId, specPointId])
  @@index([userId, mastery])
}

// ---------------------------------------------------------------------------
// Phase 6 — Flashcards (FSRS-6) and semi-blurting
// ---------------------------------------------------------------------------

/// Card text, generated once and shared by every student (doc 07 §2).
///
/// The front and back depend only on (question, mark point, spec point) — never on
/// who missed it — so at steady state creating a card is a free database lookup and
/// only a genuinely novel pair costs an API call.
model CardTemplate {
  /// "<questionId>:<markPointId>".
  id          String   @id
  questionId  String
  markPointId String
  specPointId String
  cardType    CardType @default(QA)
  front       String
  back        String
  hint        String?
  /// Model plus prompt version, so a bad generation can be found and reissued.
  generatedBy String
  /// Human spot-check flag.
  reviewed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  question  Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  specPoint SpecPoint   @relation(fields: [specPointId], references: [id], onDelete: Cascade)
  cards     Flashcard[]

  @@index([questionId])
  @@index([specPointId])
}

enum CardType {
  QA
  DEFINITION
  CLOZE
}

/// One student's card, carrying its FSRS state (D12).
model Flashcard {
  id          String @id @default(cuid())
  userId      String
  templateId  String
  specPointId String

  /// FSRS-6 state. Names mirror ts-fsrs so the mapping stays obvious.
  due            DateTime
  stability      Float     @default(0)
  difficulty     Float     @default(0)
  elapsedDays    Int       @default(0)
  scheduledDays  Int       @default(0)
  reps           Int       @default(0)
  lapses         Int       @default(0)
  learningSteps  Int       @default(0)
  state          CardState @default(NEW)
  lastReview     DateTime?

  /// Eight lapses means the idea was never understood; more repetitions won't fix it.
  leech       Boolean   @default(false)
  suspendedAt DateTime?
  /// Set when exam performance proves the point is known. Cards do not grow forever.
  retiredAt   DateTime?
  /// "From a question you got wrong on 14 Oct" — and a way to challenge it.
  sourceAttemptId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  CardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  specPoint SpecPoint    @relation(fields: [specPointId], references: [id], onDelete: Cascade)
  reviews   CardReview[]

  @@unique([userId, templateId])
  @@index([userId, due])
  @@index([userId, specPointId])
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

/// One review, storing the **prior** state in full so undo is exact (doc 07 §3).
model CardReview {
  id         String     @id @default(cuid())
  cardId     String
  userId     String
  rating     CardRating
  reviewedAt DateTime   @default(now())
  durationMs Int        @default(0)

  /// The card exactly as it was before this review. Undo restores these verbatim
  /// rather than re-deriving them, which floating-point FSRS state cannot guarantee.
  priorDue           DateTime
  priorStability     Float
  priorDifficulty    Float
  priorElapsedDays   Int
  priorScheduledDays Int
  priorReps          Int
  priorLapses        Int
  priorLearningSteps Int
  priorState         CardState
  priorLastReview    DateTime?

  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, reviewedAt])
  @@index([userId, reviewedAt])
}

enum CardRating {
  AGAIN
  HARD
  GOOD
  EASY
}

/// A semi-blurt: everything a student could remember, scored for idea coverage (D15).
model BlurtAttempt {
  id          String   @id @default(cuid())
  userId      String
  promptId    String
  text        String
  coveragePct Int      @default(0)
  /// { coverage:[{pointId,present,evidence}], extrasCorrect[], extrasWrong[], encouragement }
  detail      Json?
  markedBy    MarkedBy @default(AI_FALLBACK)
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt BlurtPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([promptId])
}
